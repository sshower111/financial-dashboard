# --- Supabase (leave blank to run in demo mode with synthetic data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server + worker only, never exposed to the browser

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                   # sandbox | production
PLAID_COUNTRY_CODES=US              # comma-separated, e.g. US,CA,GB (each must be enabled on your Plaid account)
PLAID_WEBHOOK_URL=                  # e.g. https://your-host/api/plaid/webhook
PLAID_REDIRECT_URI=                 # e.g. https://your-host/oauth  (required for OAuth banks; HTTPS in production)
PLAID_VERIFY_WEBHOOKS=true

# --- Local AI (Ollama) ---
OLLAMA_URL=http://localhost:11434
# assistant (chat) model: quality matters
OLLAMA_MODEL=qwen3.5:9b
# the assistant calls read-only finance tools (function calling) and falls back to a one-shot ledger
# snapshot if the model can't. Set to "off" to always use the snapshot.
# COPILOT_TOOLS=off

# --- Assistant model host (optional; server-side only, never NEXT_PUBLIC_*) ---
# Default is the local Ollama above. To use a hosted OpenAI-compatible endpoint with tool calling
# (Azure AI Foundry / Azure OpenAI v1 API, OpenAI, vLLM, LM Studio, ...). Ledger figures from tool
# results are then sent to that host.
# COPILOT_PROVIDER=openai-compatible
# COPILOT_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
# COPILOT_API_KEY=
# COPILOT_MODEL=your-deployment-name
# COPILOT_API_KEY_HEADER=api-key       # only for older Azure endpoints (default: Authorization: Bearer)
# COPILOT_API_VERSION=                 # only for older Azure deployment URLs

# --- Assistant tracing (no question/answer text, merchants or amounts are recorded) ---
# COPILOT_TRACE=console                # console (default) | file | off
# COPILOT_TRACE_FILE=logs/copilot-trace.jsonl
# Optional Langfuse export, off unless both keys are set:
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# worker categorization model (default: OLLAMA_MODEL). Plaid labels most rows, so the model only
# sees leftovers. Avoid tiny models: qwen2.5:1.5b filed restaurants as "Transfer".
# OLLAMA_CATEGORIZE_MODEL=qwen2.5:7b
# merchants per LLM call, and per-call timeout
CATEGORIZE_BATCH=20
OLLAMA_TIMEOUT_MS=600000

# --- Worker ---
WORKER_POLL_MS=5000
