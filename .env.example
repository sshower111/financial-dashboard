# --- Supabase (leave blank to run in demo mode with synthetic data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server + worker only, never exposed to the browser

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                   # sandbox | production
PLAID_WEBHOOK_URL=                  # e.g. https://your-host/api/plaid/webhook
PLAID_REDIRECT_URI=                 # e.g. https://your-host/oauth  (required for OAuth banks; HTTPS in production)
PLAID_VERIFY_WEBHOOKS=true

# --- Local AI (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# --- Worker ---
WORKER_POLL_MS=5000
